<Application
    RequestedThemeVariant="Light"
    x:Class="PCL.Neo_InML.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PCL.Neo_InML/Assets/Language/zh-CN.axaml" />
                <ResourceInclude Source="avares://PCL.Neo_InML/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="Pcl2English">avares://PCL.Neo_InML/Assets/Font.ttf#PCL English</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <StyleInclude Source="avares://PCL.Neo_InML/Styles/Icons.axaml" />
        <StyleInclude Source="avares://PCL.Neo_InML/Styles/MyControlStyles.axaml" />
        <StyleInclude Source="avares://PCL.Neo_InML/Styles/ComboBoxStyles.axaml" />
        <StyleInclude Source="avares://PCL.Neo_InML/Styles/CustomStyles.axaml" />
    </Application.Styles>
</Application>
